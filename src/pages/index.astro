---
import SiteLayout from '../layouts/SiteLayout.astro';
import DirectoryStory from '../components/DirectoryStory.astro';
---
<SiteLayout title="See how a project fits together" home>
  <section class="landing" aria-labelledby="page-title">
    <div class="landing-copy"><span class="eyebrow">A VISUAL GUIDE TO PROJECT STRUCTURE</span><h1 id="page-title">See how a project<br />fits <em>together.</em></h1><p>Understand the purpose behind the paths, before adding another folder.</p><a class="primary landing-cta" href="/examples/">Explore examples <span aria-hidden="true">↗</span></a></div>
    <DirectoryStory />
  </section>
  <noscript><p class="legacy-help">The full illustration works without JavaScript. Looking for an earlier section? Visit <a href="/examples/">examples</a>, the <a href="/examples/go/">Go guide</a>, <a href="/examples/astro/">Astro journey</a>, <a href="/lab/">naming lab</a>, or <a href="/sources/">sources</a>.</p></noscript>
</SiteLayout>
<script>
  import { legacyDestination } from '../domain/navigation';
  function forwardLegacySection() {
    const target = legacyDestination(window.location.hash);
    if (target) window.location.replace(target);
  }
  forwardLegacySection();
  window.addEventListener('hashchange', forwardLegacySection);
</script>
