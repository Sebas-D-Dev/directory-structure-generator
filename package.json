{
  "name": "repository-structure-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A source-backed, guest-first guide to the reasons behind repository structure.",
  "license": "MIT",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=12.2.0 <13"
  },
  "packageManager": "npm@12.2.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "start": "astro dev --host 127.0.0.1",
    "build": "npm run content:validate && astro build && node scripts/validate-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check && tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "content:validate": "node scripts/validate-content.ts",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "astro": "7.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
